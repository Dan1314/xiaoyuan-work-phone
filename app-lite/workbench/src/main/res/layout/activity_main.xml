<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="小元工作手机 · 工作中心（精简版）" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvBaseUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="12sp" />
    <Button android:id="@+id/btnCustomers" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="@string/tab_customers" />
    <Button android:id="@+id/btnCalls" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/tab_calls" />
</LinearLayout>
